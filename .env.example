# Copy this file to .env and replace the sample values. EvidenceCoder loads
# .env from the directory where you start the command. Never commit .env.
EVIDENCECODER_MODEL=your-model-name
EVIDENCECODER_BASE_URL=https://api.openai.com/v1
EVIDENCECODER_API_KEY=replace-me

# Optional runtime limits:
# EVIDENCECODER_MAX_CYCLES=30
# EVIDENCECODER_WALL_TIME=1200
